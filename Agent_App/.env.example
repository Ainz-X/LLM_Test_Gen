SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=1440
DATABASE_URL=mysql+pymysql://a3_agent:a3_agent_password@db:3306/a3_agent?charset=utf8mb4
STORAGE_DIR=/app/storage
PROJECT_ROOT=/app
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
ENABLE_JAVA_COMPILE=1
ENABLE_JAVA_COVERAGE=1
JUNIT_CLASSPATH=/opt/java-libs/junit-4.13.2.jar:/opt/java-libs/hamcrest-core-1.3.jar
JACOCO_AGENT_PATH=/opt/java-libs/org.jacoco.agent-0.8.12-runtime.jar
JACOCO_CLI_PATH=/opt/java-libs/org.jacoco.cli-0.8.12-nodeps.jar
COMPILE_TIMEOUT_SECONDS=20
TEST_TIMEOUT_SECONDS=40
MINIO_ENABLED=1
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=a3-agent
MINIO_SECURE=0
MILVUS_URI=http://milvus:19530
KNOWLEDGE_BASE_ENABLED=0
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MYSQL_DATABASE=a3_agent
MYSQL_USER=a3_agent
MYSQL_PASSWORD=a3_agent_password
MYSQL_ROOT_PASSWORD=a3_agent_root_password
